  "components": {
    "schemas": {
      "ConnectionConfig": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "auth_database": {
            "type": "string"
          },
          "direct": {
            "type": "boolean"
          },
          "hosts": {
            "type": "string"
          },
          "mechanism": {
            "type": "string"
          },
          "mode": {
