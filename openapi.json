              "null"
            ]
          },
          "username": {
            "type": "string"
          }
        }
      },
      "ConnectionView": {
        "type": "object",
        "required": [
          "id",
          "config",
          "status",
          "has_password",
          "has_uri",
          "has_ca",
          "has_client_certificate",
          "has_ssh_key",
          "has_ssh_password"
        ],
        "properties": {
          "config": {
            "$ref": "#/components/schemas/ConnectionConfig"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_ca": {
            "type": "boolean"
          },
          "has_client_certificate": {
            "type": "boolean"
          },
          "has_password": {
            "type": "boolean"
          },
          "has_ssh_key": {
            "type": "boolean"
          },
          "has_ssh_password": {
            "type": "boolean"
          },
          "has_uri": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "last_check": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "last_success": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
