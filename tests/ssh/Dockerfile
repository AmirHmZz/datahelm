FROM alpine:3.23
RUN apk add --no-cache openssh openssl && mkdir -p /root/.ssh /fixtures && ssh-keygen -A && ssh-keygen -t ed25519 -N fixture-key-passphrase -f /fixtures/client_key && cp /fixtures/client_key.pub /root/.ssh/authorized_keys && chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys && echo 'root:datahelm-test-only' | chpasswd
RUN printf '\nPermitRootLogin yes\nPasswordAuthentication yes\nAllowTcpForwarding yes\n' >> /etc/ssh/sshd_config
RUN mkdir /fixtures/tls && cd /fixtures/tls && openssl req -x509 -newkey rsa:2048 -nodes -keyout ca.key -out ca.crt -days 3650 -subj '/CN=DatahelmFixtureCA' && openssl req -newkey rsa:2048 -nodes -keyout server.key -out server.csr -subj '/CN=tls-mongo/O=DatahelmServer' && printf 'subjectAltName=DNS:tls-mongo,DNS:clickhouse,DNS:localhost,IP:127.0.0.1\nextendedKeyUsage=serverAuth,clientAuth\n' > server.ext && openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt -days 3650 -extfile server.ext && cat server.crt server.key > server.pem && openssl req -newkey rsa:2048 -nodes -keyout client.key -out client.csr -subj '/CN=datahelm-client/O=DatahelmClient' && printf 'extendedKeyUsage=clientAuth\n' > client.ext && openssl x509 -req -in client.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out client.crt -days 3650 -extfile client.ext && cat client.crt client.key > client.pem
CMD ["/usr/sbin/sshd", "-D", "-e", "-oAllowTcpForwarding=yes", "-oPermitRootLogin=yes", "-oPasswordAuthentication=yes"]
